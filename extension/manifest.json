{
  "manifest_version": 3,
  "name": "WA Recruitment Bot",
  "version": "1.0",
  "description": "AI powered WhatsApp recruitment assistant",
"permissions": [
 "storage",
    "notifications", 
    "sidePanel",
    "tabs",
    "scripting",
    "cookies" 
],
 "host_permissions": [
   "https://web.whatsapp.com/*",
  "http://localhost/*", 
  "http://127.0.0.1/*",
  "https://*.supabase.co/*"
],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
 "action": {
  "default_title": "WA Recruitment Bot",
  "default_icon": {
    "100": "icon.png"
  }
},
"icons": {
  "100": "icon.png"
},
"web_accessible_resources": [
  {
    "resources": ["icon.png"],
    "matches": ["<all_urls>"]
  }
]
}